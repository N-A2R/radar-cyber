{
  "name": "radar-cyber",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "db:up": "apps/api/node_modules/.bin/tsx db/dev-pg.mts",
    "setup": "apps/api/node_modules/.bin/tsx scripts/bootstrap.mts --with-sample",
    "setup:check": "apps/api/node_modules/.bin/tsx scripts/bootstrap.mts --check",
    "migrate": "apps/api/node_modules/.bin/tsx scripts/migrate.mts",
    "test": "pnpm -F @radar/api test",
    "api:client": "apps/api/node_modules/.bin/tsx scripts/generate-api-client.mts",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm -F @radar/api dev",
    "dev:web": "pnpm -F @radar/web dev",
    "collecte:communiques": "apps/api/node_modules/.bin/tsx scripts/collecte-communiques-officiels.mts",
    "mesure:communiques": "apps/api/node_modules/.bin/tsx scripts/mesure-communiques-officiels.mts",
    "test:offline": "pnpm -F @radar/web exec playwright test test/offline.spec.ts",
    "typecheck": "pnpm -r typecheck",
    "verify": "bash scripts/verify-all.sh",
    "verify:journal": "apps/api/node_modules/.bin/tsx scripts/verify-journal.mts",
    "replay:journal": "apps/api/node_modules/.bin/tsx scripts/replay-journal.mts",
    "mesure:couverture": "apps/api/node_modules/.bin/tsx scripts/mesure-couverture.mts",
    "couverture:corpus": "apps/api/node_modules/.bin/tsx scripts/consolider-corpus-couverture.mts",
    "couverture:mesurer": "apps/api/node_modules/.bin/tsx scripts/mesure-couverture-systeme.mts",
    "couverture:verifier": "apps/api/node_modules/.bin/tsx scripts/mesure-couverture-systeme.mts --check",
    "mesure:manques": "apps/api/node_modules/.bin/tsx scripts/manques-referentiel.mts",
    "mesure:anticipation": "apps/api/node_modules/.bin/tsx scripts/mesure-anticipation.mts",
    "anticipation:rapport": "apps/api/node_modules/.bin/tsx scripts/rapport-anticipation.mts",
    "mesure:pertinence": "apps/api/node_modules/.bin/tsx scripts/mesure-pertinence.mts",
    "mesure:confiance": "apps/api/node_modules/.bin/tsx scripts/compute-confidence-scores.mts",
    "measure:leaks-by-domain": "apps/api/node_modules/.bin/tsx scripts/measure-leaks-by-domain.mts",
    "mesure:cve-na": "apps/api/node_modules/.bin/tsx scripts/measure-cve-na.mts",
    "corpus:hash": "apps/api/node_modules/.bin/tsx scripts/corpus-hash.mts",
    "corpus:import": "apps/api/node_modules/.bin/tsx scripts/importer-corpus.mts",
    "mesure:typosquat": "apps/api/node_modules/.bin/tsx scripts/phishing-typosquat.mts",
    "enrichissement:rapport": "apps/api/node_modules/.bin/tsx scripts/enrichir-referentiel.mts --rapport",
    "enrichissement:appliquer": "apps/api/node_modules/.bin/tsx scripts/enrichir-referentiel.mts --appliquer",
    "domaines:reels": "apps/api/node_modules/.bin/tsx scripts/domaines-reels.mts",
    "domaines:mesurer": "apps/api/node_modules/.bin/tsx scripts/domain-coverage.mts",
    "domaines:etendre": "apps/api/node_modules/.bin/tsx scripts/expand-domains.mts",
    "sources:generate": "node scripts/generer-sources-actives.mts",
    "sources:measure": "node scripts/measure-active-sources.mts",
    "onion:index": "apps/api/node_modules/.bin/tsx scripts/build-onion-index.mts",
    "measure:live-sources": "apps/api/node_modules/.bin/tsx scripts/measure-live-source-stream.mts",
    "measure:map-timeline": "apps/api/node_modules/.bin/tsx scripts/measure-map-timeline.mts"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
