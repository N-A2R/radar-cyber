{
  "name": "@radar/web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:render": "vite build --ssr test/render.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/render.js",
    "test:dom": "vite build --ssr test/review-dom.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/review-dom.js",
    "test:sources": "vite build --ssr test/sources-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/sources-verif.js",
    "test:inspecteur": "vite build --ssr test/inspecteur-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/inspecteur-verif.js",
    "test:fil": "vite build --ssr test/fil-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/fil-verif.js",
    "test:etat": "vite build --ssr test/etat-rendu.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/etat-rendu.js",
    "test:corroboration": "vite build --ssr test/corroboration-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/corroboration-verif.js",
    "test:offline": "vite build --ssr test/offline-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/offline-verif.js"
  },
  "dependencies": {
    "@radar/shared": "workspace:*",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@tanstack/table-core": "9.3.1",
    "maplibre-gl": "^6.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "26.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.7"
  }
}
