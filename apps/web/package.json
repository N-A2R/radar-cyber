    "test:revue": "vite build --ssr test/revue-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/revue-verif.js",
    "test:bulk": "vitest run test/ReviewView.bulk.test.tsx --environment jsdom",
    "test:alerts": "vitest run test/alerts-live.test.tsx --environment jsdom",
    "test:review-keys": "vitest run test/ReviewView.keys.test.tsx --environment jsdom",
    "test:sources": "vite build --ssr test/sources-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/sources-verif.js",
    "test:sources-tri": "vite build --ssr test/sources-tri-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/sources-tri-verif.js",
