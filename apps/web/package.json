  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "26.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.7",
    "vitest": "5.1.1"
  }
