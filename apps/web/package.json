    "test:collecte": "vite build --ssr test/collecte-metrics-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/collecte-metrics-verif.js",
    "test:aujourdhui": "vite build --ssr test/aujourdhui-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/aujourdhui-verif.js",
    "test:timeline": "vite build --ssr test/timeline-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/timeline-verif.js",
    "test:liees": "vite build --ssr test/liees-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/liees-verif.js",
    "test:sources-rouges": "vite build --ssr test/sources-rouges-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/sources-rouges-verif.js",
    "test:journal": "vite build --ssr test/journal-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/journal-verif.js",
    "test:droit-reponse": "vite build --ssr test/droit-reponse-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/droit-reponse-verif.js",
    "test:etats-vides": "vite build --ssr test/etats-vides-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/etats-vides-verif.js",
