{
  "name": "@radar/web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:render": "vite build --ssr test/render.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/render.js",
    "test:keys": "vite build --ssr test/review-keys-verif.tsx --outDir .smoke-out --logLevel warn && node .smoke-out/review-keys-verif.js",
