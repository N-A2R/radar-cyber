{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.misp-project.org/schemas/misp-core-format-event.json",
  "title": "MISP core format Event",
  "description": "Event MISP validé d'après draft-dulaunoy-misp-core-format (MISP core format) : champs MUST/SHALL de Event, Org, Orgc, Attribute et Tag. Le test export-misp.test.ts valide chaque événement du flux avec ce schéma.",
  "type": "object",
  "additionalProperties": false,
  "required": ["Event"],
  "properties": {
    "Event": { "$ref": "#/definitions/event" }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "unsignedInteger": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "org": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "uuid"],
      "properties": {
        "id": { "$ref": "#/definitions/unsignedInteger" },
        "name": { "type": "string", "minLength": 1 },
        "uuid": { "$ref": "#/definitions/uuid" }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "exportable": { "type": "boolean" }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "event_id", "uuid", "type", "category", "to_ids",
        "distribution", "sharing_group_id", "deleted", "timestamp", "value"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/unsignedInteger" },
        "event_id": { "$ref": "#/definitions/unsignedInteger" },
        "uuid": { "$ref": "#/definitions/uuid" },
        "type": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "to_ids": { "type": "boolean" },
        "distribution": { "type": "string", "enum": ["0", "1", "2", "3", "4", "5"] },
        "sharing_group_id": { "$ref": "#/definitions/unsignedInteger" },
        "deleted": { "type": "boolean" },
        "timestamp": { "$ref": "#/definitions/timestamp" },
        "value": { "type": "string", "minLength": 1, "maxLength": 255 },
        "comment": { "type": "string" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "uuid", "info", "date", "timestamp", "publish_timestamp",
        "first_publication", "published", "threat_level_id", "analysis",
        "distribution", "sharing_group_id", "org_id", "orgc_id",
        "attribute_count", "locked", "Org", "Orgc", "Attribute", "Tag"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/unsignedInteger" },
        "uuid": { "$ref": "#/definitions/uuid" },
        "info": { "type": "string", "minLength": 1, "maxLength": 256 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "timestamp": { "$ref": "#/definitions/timestamp" },
        "publish_timestamp": { "$ref": "#/definitions/timestamp" },
        "first_publication": { "$ref": "#/definitions/timestamp" },
        "published": { "type": "boolean" },
        "threat_level_id": { "type": "string", "enum": ["1", "2", "3", "4"] },
        "analysis": { "type": "string", "enum": ["0", "1", "2"] },
        "distribution": { "type": "string", "enum": ["0", "1", "2", "3", "4"] },
        "sharing_group_id": { "$ref": "#/definitions/unsignedInteger" },
        "org_id": { "$ref": "#/definitions/unsignedInteger" },
        "orgc_id": { "$ref": "#/definitions/unsignedInteger" },
        "attribute_count": { "$ref": "#/definitions/unsignedInteger" },
        "locked": { "type": "boolean" },
        "Org": { "$ref": "#/definitions/org" },
        "Orgc": { "$ref": "#/definitions/org" },
        "Attribute": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/attribute" }
        },
        "Tag": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/tag" }
        }
      }
    }
  }
}
