# Unité système générée par scripts/deploy/install.sh.
[Unit]
Description=Radar Cyber — interface web (serveur statique Node)
Documentation=file:/opt/radar-cyber/current/docs/operations.md
After=network-online.target postgresql.service radar-api.service
Wants=network-online.target
Requires=radar-api.service

[Service]
Type=simple
User=radar
Group=radar
WorkingDirectory=/opt/radar-cyber/current/apps/web
Environment=WEB_DIST=/opt/radar-cyber/current/apps/web/dist
EnvironmentFile=/etc/radar-cyber/radar.env
ExecStart=node /opt/radar-cyber/current/apps/web/serve.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/radar-cyber /opt/radar-cyber
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
