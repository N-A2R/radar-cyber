/**
 * Regenerate the frozen v1 contract snapshot from the live operation catalog.
 * Run only when publishing a new version of the API:
 *   apps/api/node_modules/.bin/tsx scripts/generate-api-contract.mts
 */
import { writeFileSync } from "node:fs";
import { OPERATIONS } from "../apps/api/src/openapi/catalog.js";
import { buildContract } from "../apps/api/src/openapi/contract.js";
import { API_VERSION } from "../apps/api/src/openapi/version.js";

const contract = buildContract(OPERATIONS, API_VERSION, "2026-11-22");
const body = `/**
 * Frozen v1 contract — generated by scripts/generate-api-contract.mts.
 * Every entry is a published compatibility promise: never edit by hand.
 */
import type { FrozenContract } from "./contract.js";

export const V1_CONTRACT: FrozenContract = ${JSON.stringify(contract, null, 2)};
`;
writeFileSync(new URL("../apps/api/src/openapi/v1-contract.ts", import.meta.url), body);
console.log(`Frozen ${contract.operations.length} operations for ${contract.version}: ${contract.digest}`);
