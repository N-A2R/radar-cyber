# radar-report.service — rapport hebdomadaire Radar Cyber.
#
# install.sh remplace @REPO@ et @PATH@ puis écrit l'unité rendue dans
# ~/.config/systemd/user/. Modèle versionné : aucun chemin absolu, aucun secret.
[Unit]
Description=Radar Cyber — rapport hebdomadaire (HTML + Markdown)
Documentation=file:@REPO@/docs/operations.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO@/apps/api
# PATH figé : systemd --user n'hérite pas du PATH de la session (node via mise).
Environment=PATH=@PATH@
Environment=HOME=%h
EnvironmentFile=%h/.config/radar-cyber/api-security.env
ExecStart=/usr/bin/env bash @REPO@/scripts/report-weekly.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
UMask=0077
