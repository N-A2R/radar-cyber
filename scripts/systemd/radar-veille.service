# radar-veille.service — cycle de veille quotidien Radar Cyber.
#
# install.sh remplace @REPO@ et @PATH@ et écrit l'unité rendue dans
# ~/.config/systemd/user/. Le modèle versionné n'embarque aucun chemin absolu
# ni secret ; DATABASE_URL vient du fichier d'environnement protégé.
[Unit]
Description=Radar Cyber — veille quotidienne (collecte, incidents, confiance, résumé)
Documentation=file:@REPO@/docs/operations.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO@/apps/api
Environment=PATH=@PATH@
Environment=HOME=%h
EnvironmentFile=%h/.config/radar-cyber/api-security.env
ExecStart=/usr/bin/env bash @REPO@/scripts/veille-quotidienne.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
UMask=0077
