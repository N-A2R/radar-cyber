# Caddyfile — frontal optionnel (TLS/LAN) pour un déploiement derrière Caddy.
# Le service `web` (Vite preview :4173, compose par défaut) proxifie déjà /api
# vers l'API ; ce fichier est donc facultatif. Exemple d'usage :
#   caddy run --config ./Caddyfile --envfile .env
# ou comme service additionnel pointant sur le réseau compose (web:4173, api:8080).

:80 {
	encode gzip

	# API Fastify (réponses JSON / SSE) — bypass du cache statique.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8080
	}

	# Interface web (Vite preview) + SPA fallback.
	handle {
		reverse_proxy web:4173
	}
}
