# Dépendances (le motif sans slash attrape aussi les liens symboliques nus)
node_modules
node_modules/
.pnpm-store/

# Données locales PostgreSQL (ne jamais versionner)
apps/api/pgdata/
pgdata/
pgdata-*/
data/warc/
*.sqlite
*.db
*.db-wal
*.db-shm

# Secrets et environnement
.env
.env.*
!.env.example

# Build
dist/
build/
*.tsbuildinfo
.vite/
.smoke-out/
storybook-static/

# Logs et artefacts
*.log
logs/
nohup.out
coverage/
out/

# Dossiers exportés et jetons joints : régénérables par `pnpm scelle:exports`.
exports/scelles/

# Exports mensuels régénérables par `pnpm export:violations-rgpd`.
exports/violations/

# Journaux générés par le service (données locales)
journal/journal_root_*.json
apps/api/journal/

# Python (tests hors ligne)
__pycache__/
*.pyc
.pytest_cache/

# Benches : les prédictions du bench B sont régénérables depuis le corpus
# externe (~2,6 Mo) ; on ne versionne que les scores et les temps mesurés.
bench/results/B-*.json
!bench/results/B-scores.json
!bench/results/B-runtime.json

# Système
.DS_Store
Thumbs.db

# Artefacts locaux du skill de design
.hallmark/

# empreinte recalculable du corpus : elle change à chaque ajout de source et
# provoque un conflit sur toutes les branches. On la calcule, on ne la versionne pas.
bench/corpus/HASH
