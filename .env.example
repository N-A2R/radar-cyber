# Radar Cyber NA — variables d'environnement (exemple).
# Copier en .env ou exporter avant `docker compose up`. AUCUN secret ici.

# --- PostgreSQL (service db) -------------------------------------------------
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar  # dev only; set explicitly in production
POSTGRES_DB=radar
# Port hôte publié par compose (5433 par défaut pour éviter un conflit avec un
# PostgreSQL local sur 5432). L'API du conteneur joint db:5432 en interne.
RADAR_DB_PORT=5433

# --- API Fastify (service api) -----------------------------------------------
# Chaîne de connexion. En conteneur, compose la surchage pour pointer sur db ;
# cette valeur vaut pour un lancement hors conteneur (localhost).
DATABASE_URL=postgres://radar:radar@localhost:5432/radar
HOST=127.0.0.1
PORT=8080
RADAR_API_PORT=8080

# Clé du modèle de décision (optionnelle, pas de valeur par défaut).
INCEPTION_API_KEY=

# Proxy SOCKS5 pour les sources .onion (Tor). Sans proxy, les requêtes .onion
# échouent immédiatement (aucun repli clearnet). Profil "tor" : socks5h://tor:9050.
RADAR_TOR_SOCKS=

# Rétention (jours) : événements / indicateurs.
RADAR_RETENTION_DAYS=90
RADAR_RETENTION_INDICATOR_DAYS=365

# --- Sécurité / conformité (voir docs/conformite.md) ------------------------
# Poivre du hash des IP et user-agents du journal des accès. OBLIGATOIRE en
# production : l'API refuse de démarrer sans valeur. 32+ octets aléatoires.
RADAR_AUDIT_PEPPER=
# Limite globale par utilisateur (ou IP) et fenêtre en ms ; les routes
# sensibles ont leur propre limite.
RADAR_RATE_LIMIT_MAX=300
RADAR_RATE_LIMIT_WINDOW_MS=60000
# Rétention du journal des accès (jours). Les refus restent dans le journal
# de vérité au-delà de cette durée.
RADAR_AUDIT_RETENTION_DAYS=90

# --- Rattachement : règles de précision (vague branchement) -------------------
# on : les six règles de précision (apps/api/src/match/regles-precision.ts)
# refusent les rattachements non fondés au point de décision de la promotion,
# avec journalisation de la règle (kind `match.refuse`) ; off : comportement
# livré inchangé. Le compromis précision/couverture mesuré et la
# recommandation : docs/rapport-regles-branchees.md. Défaut : off.
PRECISION_RULES=off

# Clés optionnelles de collecteurs (laisser vide si indisponibles).
ABUSECH_AUTH_KEY=
VT_API_KEY=

# --- Web (service web, Vite preview) -----------------------------------------
RADAR_WEB_PORT=4173
WEB_PORT=4173
# Cible du proxy /api lue par scripts/systemd/preview.config.mjs (compose :
# http://api:8080 ; hors conteneur : http://127.0.0.1:8080).
API_PROXY_TARGET=http://127.0.0.1:8080

# --- Diffusion des alertes (optionnel) ---------------------------------------
# Sans aucune variable ci-dessous : aucun envoi, aucune erreur au démarrage.
# Webhook JSON (POST). Exemple : https://hooks.example.test/radar
RADAR_ALERT_WEBHOOK_URL=
# Telegram Bot API (sendMessage). Les deux variables sont requises.
RADAR_ALERT_TELEGRAM_BOT_TOKEN=
RADAR_ALERT_TELEGRAM_CHAT_ID=
# Base publique du front pour construire un lien d'alerte (optionnel).
RADAR_WEB_BASE_URL=
# Cadence de diffusion en millisecondes (défaut : 120000).
RADAR_ALERT_DELIVERY_TICK_MS=120000
# Cadence de la politique de fatigue d'alerte (défaut : 60000) : déduplication
# organisation/jour/règle et republication de la charge sur 30 jours glissants.
RADAR_ALERT_FATIGUE_TICK_MS=60000

# --- Filtrage par langue des événements -------------------------------------
# Langues ingérées (fr,en). La langue est détectée sur le titre + résumé et
# stockée dans event.langue. Vide ou valeur inconnue = fr et en (défaut).
RADAR_LANGUAGES=fr,en


# --- Filtre de pertinence cyber ---------------------------------------------
# Termes ajoutés au lexique intégré (séparés par des virgules) ; jamais de
# dépendance npm. Ex. : RADAR_CYBER_KEYWORDS=supply chain,scada
RADAR_CYBER_KEYWORDS=
# Phrases annulant un score faible (ex. virus hivernaux, attaques de loup).
# Un signal fort (CVE, ransomware, org citée) reste admis malgré une exclusion.
RADAR_CYBER_EXCLUSIONS=
# Score minimal d'admission, entier 1-10 (défaut : 2).
RADAR_CYBER_MIN_SCORE=2
# --- Divers ------------------------------------------------------------------
TZ=Europe/Paris
