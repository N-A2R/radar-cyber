# Radar Cyber NA — variables d'environnement (exemple).
# Copier en .env ou exporter avant `docker compose up`. Remplacer les valeurs
# CHANGE_ME avant tout lancement réel. AUCUN secret ici.

# --- PostgreSQL (service db) -------------------------------------------------
POSTGRES_USER=radar
# Valeur d'exemple non secrète, alignée sur DATABASE_URL ci-dessous.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=radar
# Port hôte publié par compose (5433 par défaut pour éviter un conflit avec un
# PostgreSQL local sur 5432). L'API du conteneur joint db:5432 en interne.
RADAR_DB_PORT=5433

# --- API Fastify (service api) -----------------------------------------------
# Chaîne de connexion. En conteneur, compose la surchage pour pointer sur db ;
# cette valeur vaut pour un lancement hors conteneur (localhost).
DATABASE_URL=postgres://radar:CHANGE_ME@localhost:5433/radar
# URL d'administration utilisée par ExecStartPre des unités systemd pour
# `scripts/migrate.mts`. En local elle peut être identique à DATABASE_URL ;
# en production elle doit désigner un rôle DDL distinct du rôle applicatif.
RADAR_MIGRATE_DATABASE_URL=postgres://radar:CHANGE_ME@localhost:5433/radar
HOST=127.0.0.1
PORT=8080
NODE_ENV=production
RADAR_API_PORT=8080

# --- Scellement des exports publics (RFC 3161) -------------------------------
# TSA utilisée pour horodater les octets de chaque dossier téléchargé.
RADAR_TSA_URL=https://freetsa.org/tsr
# Déclaration du prestataire au regard de la liste nationale de confiance.
# Le service public par défaut n'est PAS qualifié : ne pas le revendiquer.
RADAR_TSA_PRESTATAIRE_ANSSI=FreeTSA (freetsa.org) — jeton RFC 3161 public ; hors liste nationale de confiance ANSSI (qualification non revendiquée)
# Ancre de confiance PEM optionnelle pour vérifier la chaîne du certificat TSA.
# Sans elle, la signature CMS et l'EKU sont vérifiées, mais la chaîne n'est pas
# revendiquée comme ancrée dans un magasin de confiance.
RADAR_TSA_CA_PEM=
# Ne désactiver que dans les tests d'intégration (aucun appel réseau).
# RADAR_EXPORT_SCELLEMENT=0

# Clé du modèle de décision (optionnelle, pas de valeur par défaut).
INCEPTION_API_KEY=

# Proxy SOCKS5 pour les sources .onion (Tor). Sans proxy, les requêtes .onion
# échouent immédiatement (aucun repli clearnet). Profil "tor" : socks5h://tor:9050.
RADAR_TOR_SOCKS=

# Rétention (jours) : événements / indicateurs.
RADAR_RETENTION_DAYS=90
RADAR_RETENTION_INDICATOR_DAYS=365

# --- Sécurité / conformité (voir docs/conformite.md) ------------------------
# Poivre du hash des IP et user-agents du journal des accès. OBLIGATOIRE en
# production : l'API refuse de démarrer sans valeur. 32+ octets aléatoires.
# Générer avec : openssl rand -hex 32
# Valeur d'exemple non secrète : docker compose exige une valeur non vide.
RADAR_AUDIT_PEPPER=CHANGE_ME_REPLACE_WITH_openssl_rand_hex_32
# Origines CORS explicites, séparées par des virgules. Vide = même origine only.
RADAR_CORS_ORIGINS=
# Nombre de proxies de confiance devant l'API (0 si exposition directe).
RADAR_TRUST_PROXY=0
# Limite globale par utilisateur (ou IP) et fenêtre en ms ; les routes
# sensibles ont leur propre limite.
RADAR_RATE_LIMIT_MAX=300
RADAR_RATE_LIMIT_WINDOW_MS=60000
# Rétention du journal des accès (jours). Les refus restent dans le journal
# de vérité au-delà de cette durée.
RADAR_AUDIT_RETENTION_DAYS=90

# --- Rattachement : règles de précision ------------------------------------
# Les six règles de précision (apps/api/src/match/regles-precision.ts) sont
# actives par défaut: elles refusent les rattachements non fondés et journalisent
# la règle (`match.refuse`). `off` est un opt-out explicite pour les tests ou
# une comparaison contrôlée. Détail: docs/rapport-regles-branchees.md.
PRECISION_RULES=on

# Clés optionnelles de collecteurs (laisser vide si indisponibles).
ABUSECH_AUTH_KEY=
VT_API_KEY=

# --- Web (service web, serveur statique Node) -------------------------------
RADAR_WEB_PORT=4173
WEB_PORT=4173
WEB_HOST=0.0.0.0
# Cible optionnelle du proxy /api lue par apps/web/serve.mjs (compose:
# http://api:8080 ; hors conteneur: http://127.0.0.1:8080).
API_PROXY_TARGET=http://127.0.0.1:8080
# Caddy optionnel sur l'hôte : upstreams par défaut sur la boucle locale.
# Un frontal dans un autre réseau doit surcharger ces deux valeurs.
# RADAR_API_UPSTREAM=127.0.0.1:8080
# RADAR_WEB_UPSTREAM=127.0.0.1:4173

# --- Diffusion des alertes (optionnel) ---------------------------------------
# Sans aucune variable ci-dessous : aucun envoi, aucune erreur au démarrage.
# Webhook JSON (POST). Exemple : https://hooks.example.test/radar
RADAR_ALERT_WEBHOOK_URL=
# Shared HMAC-SHA256 secret for webhook signatures. Required when a URL is set.
# Generate one with: openssl rand -hex 32
RADAR_ALERT_WEBHOOK_SECRET=
# Telegram Bot API (sendMessage). Les deux variables sont requises.
RADAR_ALERT_TELEGRAM_BOT_TOKEN=
RADAR_ALERT_TELEGRAM_CHAT_ID=
# Email delivery through a reachable SMTP server (local relay is enough).
# All three variables are required; no paid provider or third-party relay.
RADAR_ALERT_EMAIL_HOST=
RADAR_ALERT_EMAIL_PORT=25
RADAR_ALERT_EMAIL_FROM=
RADAR_ALERT_EMAIL_TO=
# Optional SMTP authentication and implicit TLS (port 465).
RADAR_ALERT_EMAIL_USER=
RADAR_ALERT_EMAIL_PASSWORD=
RADAR_ALERT_EMAIL_SECURE=
# Délai maximal d'une session SMTP en ms (100–120000, défaut : 15000).
RADAR_ALERT_EMAIL_TIMEOUT_MS=15000
# Public RSS feed: GET /api/alerts/rss.xml (20 most recent NA alerts).
# Base publique du front pour construire un lien d'alerte (optionnel).
RADAR_WEB_BASE_URL=
# Cadence de diffusion en millisecondes (défaut : 120000).
RADAR_ALERT_DELIVERY_TICK_MS=120000
# Cadence de la politique de fatigue d'alerte (défaut : 60000) : déduplication
# organisation/jour/règle et republication de la charge sur 30 jours glissants.
RADAR_ALERT_FATIGUE_TICK_MS=60000

# --- Filtrage par langue des événements -------------------------------------
# Langues ingérées (fr,en). La langue est détectée sur le titre + résumé et
# stockée dans event.langue. Vide ou valeur inconnue = fr et en (défaut).
RADAR_LANGUAGES=fr,en


# --- Filtre de pertinence cyber ---------------------------------------------
# Termes ajoutés au lexique intégré (séparés par des virgules) ; jamais de
# dépendance npm. Ex. : RADAR_CYBER_KEYWORDS=supply chain,scada
RADAR_CYBER_KEYWORDS=
# Phrases annulant un score faible (ex. virus hivernaux, attaques de loup).
# Un signal fort (CVE, ransomware, org citée) reste admis malgré une exclusion.
RADAR_CYBER_EXCLUSIONS=
# Score minimal d'admission, entier 1-10 (défaut : 2).
RADAR_CYBER_MIN_SCORE=2
# --- Divers ------------------------------------------------------------------
TZ=Europe/Paris
